# ============================================================
# TraceGuard — Environment Variables Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- FastAPI Backend ---
DATABASE_URL=postgresql+asyncpg://traceguard:changeme@localhost:5432/traceguard
SECRET_KEY=replace-with-a-cryptographically-secure-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,chrome-extension://*

# --- Next.js Dashboard ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- PostgreSQL (for docker-compose) ---
POSTGRES_USER=traceguard
POSTGRES_PASSWORD=changeme
POSTGRES_DB=traceguard

# --- Development ---
NODE_ENV=development
LOG_LEVEL=info
