{
  "name": "@traceguard/shared-types",
  "version": "0.1.0",
  "description": "Shared TypeScript interfaces and Zod schemas for TraceGuard",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "rimraf": "^5.0.7",
    "typescript": "^5.5.2"
  },
  "dependencies": {
    "zod": "^3.23.8"
  }
}
