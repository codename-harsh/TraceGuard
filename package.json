{
  "name": "traceguard",
  "version": "0.1.0",
  "private": true,
  "description": "TraceGuard — Web Privacy & Security Intelligence. See what a website does behind the page.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:dashboard": "pnpm --filter @traceguard/dashboard dev",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:api": "node scripts/test-api.mjs",
    "test:all": "node scripts/test-all.mjs",
    "test:e2e": "playwright test",
    "migrate": "node scripts/migrate.mjs",
    "seed": "node scripts/seed.mjs",
    "demo": "node scripts/demo.mjs",
    "reset": "node scripts/reset.mjs",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.57.0",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.4.0"
}
